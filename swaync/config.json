{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "control-center-width": 500,
  "notification-window-width": 500,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "text-empty": "󰍹  // SYSTEM CLEAR // NO NEW ALERTS",
  "scripts": {
    "sound-script": {
      "exec": "paplay ~/.config/swaync/notification.ogg",
      "app-name": ".*"
    }
  },
  "widgets": ["title", "buttons-grid", "mpris"],
  "widget-config": {
    "title": {
      "text": "SYSTEM // NOTIFICATIONS",
      "clear-all-button": true,
      "button-text": "[ PURGE ]"
    },
    "mpris": {
      "blacklist": ["playerctl"],
      "autohide": false,
      "show-album-art": "always",
      "loop-carousel": false
    },
    "volume": {
      "label": "󰕾"
    },
    "backlight": {
      "label": "󰃟"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰍃",
          "command": "hyprctl dispatch exit"
        },
        {
          "label": "󰍬",
          "command": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
          "type": "toggle",
          "update-command": "bash -c 'LC_ALL=C pactl get-source-mute @DEFAULT_SOURCE@ | grep -q yes && echo false || echo true'"
        },
        {
          "label": "󰖩",
          "command": "rfkill toggle wifi",
          "type": "toggle",
          "update-command": "bash -c 'LC_ALL=C rfkill list wifi | grep -q yes && echo false || echo true'"
        },
        {
          "label": "󰂯",
          "command": "rfkill toggle bluetooth",
          "type": "toggle",
          "update-command": "bash -c 'LC_ALL=C rfkill list bluetooth | grep -q yes && echo false || echo true'"
        },
        {
          "label": "",
          "command": "kooha"
        }
      ]
    }
  }
}