{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    /*"logo": {
        "type": "file",
        "source": "~/.config/fastfetch/eva_logo.txt",
        "color": {
            "1": "magenta",
            "2": "green",
            "3": "yellow",
            "4": "white",
            "5": "cyan",
            "6": "blue"
        },
        "padding": {
            "top": 1,
            "right": 4
        }
    }*/
    "logo": {
        "type": "kitty-icat",
        "source": "~/.config/fastfetch/eva.gif",
        "padding": {
            "top": 1,
            "right": 4
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "break",
        { "type": "os", "key": "OS    ", "keyColor": "35" },
        { "type": "kernel", "key": "Kernel", "keyColor": "35" },
        { "type": "uptime", "key": "Uptime", "keyColor": "35" },
        { "type": "packages", "key": "Pkgs  ", "keyColor": "35" },
        { "type": "shell", "key": "Shell ", "keyColor": "35" },
        { "type": "display", "key": "Disp  ", "keyColor": "35" },
        { "type": "cpu", "key": "CPU   ", "keyColor": "35" },
        { "type": "memory", "key": "Mem   ", "keyColor": "35" },
        { "type": "break" },
        {
            "type": "custom",
            "format": "\u001b[1;30m⬣ \u001b[1;31m⬣ \u001b[1;32m⬣ \u001b[1;33m⬣ \u001b[1;34m⬣ \u001b[1;35m⬣ \u001b[1;36m⬣ \u001b[1;37m⬣ \u001b[0m"
        }
    ]
}